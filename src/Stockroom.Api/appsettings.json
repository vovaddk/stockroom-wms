{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=StockroomWms;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "stockroom",
    "Audience": "stockroom",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "PutAway": {
    "Strategies": [ "ConsolidateSameLot", "EmptyBinInAbcZone", "AnyBinWithCapacity" ]
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  }
}
